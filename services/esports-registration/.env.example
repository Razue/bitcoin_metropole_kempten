# Local-only eSports service. Do not reuse the ticket backend's .env.
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/esports.db
ALLOWED_ORIGIN=https://razue.github.io
# Phase 3A keeps real public intake disabled. Tests enable it in-process only.
REGISTRATION_ENABLED=false
# FC Season 1 confirms a valid nickname + email immediately; no message is sent.
# Future seasons may opt into the retained pending/confirmation flow explicitly.
EMAIL_CONFIRMATION_ENABLED=false
# Mail delivery: inert by default. Set MAIL_DELIVERY_ENABLED=true plus a provider to enable.
# Supported providers (Phase 3B ships with placeholders): smtp, api
MAIL_DELIVERY_ENABLED=false
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=no-reply@bitcoinmetropole.de
MAIL_BASE_URL=
# Global in-memory rate limiting for email endpoints (no IP or identifier storage).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
